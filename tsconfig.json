{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node", "$app/types", "./src/worker-configuration.d.ts"]
	},
	"include": ["src", "vite.config.ts"],
	// Imports the worker adapter-cloudflare only writes at build time.
	"exclude": ["src/worker.ts"]
}
