{
	"name": "fluentui-icons-svelte",
	"version": "1.1.1",
	"description": "FluentUI Icons for Svelte 5",
	"repository": {
		"type": "git",
		"url": "https://github.com/JLAcostaEC/fluentui-icons-svelte"
	},
	"author": {
		"name": "Jorge Acosta",
		"url": "https://github.com/JLAcostaEC"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"fluent",
		"fluent-ui",
		"fluentui",
		"components",
		"fluentui-components",
		"svelte-components",
		"svelte-5",
		"svelte-5-components",
		"winui",
		"win-ui",
		"windows-ui",
		"microsoft-ui",
		"fluentui-icons-svelte",
		"fluentui-icons",
		"fluentui-svg-icons",
		"icons",
		"svg-icons"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm generate && vite build && pnpm prepare",
		"build:package": "pnpm generate && vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"generate:color": "svgtosvelte src/internal/icons -t -r -f filled regular light -e 24",
		"generate:mono": "svgtosvelte src/internal/icons -t -a *fill.currentColor -r -f color -e 24 32",
		"generate:registry": "node scripts/enrich-registry.mjs",
		"generate": "pnpm generate:color && pnpm generate:mono && pnpm generate:registry",
		"changeset:version": "changeset version && git add --all",
		"changeset:publish": "changeset publish",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts",
		"deploy": "pnpm run build && wrangler pages deploy"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./*.svelte": {
			"types": "./dist/*.svelte.d.ts",
			"import": "./dist/*.svelte"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@jlacostaec/svgtosvelte": "^3.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fluentui-svelte": "^0.5.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"wrangler": "^4.148.0"
	},
	"packageManager": "pnpm@12.7.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#internal/*": "./src/internal/*"
	}
}